# --- Database (postgres://... in production, file:... for local sqlite dev) ---
DATABASE_URI=file:./dev.db

# --- Payload ---
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Site ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Transactional email (Resend) ---
RESEND_API_KEY=re_placeholder
EMAIL_FROM=GenMedha Hub <hello@genmedhahub.com>

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=genmedhahub-dev
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
S3_REGION=eu-central-1

# --- Scheduling embed (Cal.com) ---
CALCOM_EMBED_URL=https://cal.com/genmedhahub

# --- Newsletter (Listmonk) ---
LISTMONK_URL=https://lists.example.com
LISTMONK_API_USER=placeholder
LISTMONK_API_TOKEN=placeholder

# --- Analytics (Umami) ---
UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
